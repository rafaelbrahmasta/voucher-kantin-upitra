# Salin menjadi .env lalu sesuaikan. Jangan masukkan .env ke Git.
APP_ENV=dev
APP_ADDR=:8080
TZ_NAME=Asia/Jakarta

DATABASE_URL=postgres://voucher:voucher@localhost:5432/voucher?sslmode=disable

# Kunci rahasia, minimal 32 karakter. GANTI di produksi (buat dengan: openssl rand -hex 32)
QR_KEY=dev-only-qr-key-change-me-0123456789abcdef
SHORT_KEY=dev-only-short-key-change-me-0123456789abcdef

# Email: log (hanya cetak ke terminal) atau smtp (Mailpit / Gmail dummy)
MAIL_DRIVER=smtp
MAIL_FROM=Voucher Kantin UPITRA <voucher@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Hanya untuk mode dev: tenant yang dianggap melakukan scan (belum ada login)
DEV_TENANT_ID=1
DEV_TENANT_USER_ID=1
